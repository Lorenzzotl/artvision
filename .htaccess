# ==========================================================================
# ARTVISION — configuração para hospedagem Apache/LiteSpeed (ex.: Hostinger)
# (o GitHub Pages ignora este arquivo — pode manter no repositório)
# ==========================================================================

# Tipos MIME corretos
AddType video/mp4 .mp4
AddType image/webp .webp
AddType application/json .json

# Cache longo para mídia e assets (os vídeos não mudam de nome)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

# Compressão para texto (HTML/CSS/JS/JSON) — vídeo já é comprimido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Força HTTPS (descomente depois de ativar o SSL no hPanel)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
